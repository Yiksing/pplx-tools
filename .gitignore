# Python
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# User-level real config and local override pairs (private, never committed)
# 用户级真实配置与本地覆盖对（含个人隐私，绝不入库）
scrub_pairs.local.json
tests/scrub_pairs.local.json

# cookie 缓存与日志（含会话凭证 / 签名 URL）
.cookies.json
**/index/.cookies.json
logs/

# MkDocs build output
# MkDocs 构建产物
site/

# 默认归档输出（本仓库只发布工具，不发布归档内容）
web_archive/

# 编辑器/代理本地工作数据（不入库；无尾斜杠，兼容 .qoder 为目录或指向 .agents 的软链接）
.qoder
# Per-machine agent permission grants (local tool state, contains an absolute path)
# 本机 agent 权限授予（本地工具状态，含绝对路径）
.agents/settings.local.json

# macOS
.DS_Store
